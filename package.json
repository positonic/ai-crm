{
  "name": "ftc-t3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "dev:log": "next dev 2>&1 | tee ftc.log",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:smoke": "playwright test tests/e2e/smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:email": "vitest run --grep 'Email'",
    "test:coverage": "vitest run --coverage",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:form": "vitest run --config vitest.config.form.ts src/app/_components/__tests__/core-form-logic.test.ts src/app/_components/__tests__/simple-validation.test.ts",
    "test:form-performance": "vitest run --config vitest.config.form.ts src/app/_components/__tests__/performance.test.tsx",
    "test:form-integration": "vitest run --config vitest.config.form.ts src/app/_components/__tests__/form-integration.test.tsx",
    "test:form-scroll": "vitest run --config vitest.config.form.ts src/app/_components/__tests__/scroll-behavior.test.tsx",
    "test:form-validation": "vitest run --config vitest.config.form.ts src/app/_components/__tests__/form-validation.test.tsx",
    "test:form-watch": "vitest watch --config vitest.config.form.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:staged": "git diff --cached --name-only --diff-filter=ACM | grep -E '\\.(ts|tsx)$' | xargs -r bun run lint --",
    "check:changed": "git diff HEAD --name-only --diff-filter=ACM | grep -E '\\.(ts|tsx)$' | xargs -r bun run lint --",
    "typecheck:staged": "git diff --cached --name-only --diff-filter=ACM | grep -E '\\.(ts|tsx)$' | xargs -r bunx tsc --noEmit --skipLibCheck",
    "typecheck:changed": "git diff HEAD --name-only --diff-filter=ACM | grep -E '\\.(ts|tsx)$' | xargs -r bunx tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.1",
    "@atproto/api": "^0.17.4",
    "@atproto/oauth-client-browser": "^0.3.34",
    "@atproto/oauth-client-node": "^0.3.10",
    "@auth/prisma-adapter": "^2.7.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@ethereum-attestation-service/eas-sdk": "^2.9.0",
    "@mantine/charts": "^8.3.9",
    "@mantine/core": "8.1.1",
    "@mantine/dates": "^8.2.5",
    "@mantine/form": "^8.2.5",
    "@mantine/hooks": "8.1.1",
    "@mantine/notifications": "^8.2.5",
    "@mastra/client-js": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@notionhq/client": "^4.0.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.5.0",
    "@react-email/components": "^0.5.1",
    "@react-email/render": "^1.2.1",
    "@sentry/nextjs": "^10.21.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "ethers": "^6.16.0",
    "googleapis": "^150.0.1",
    "html-to-image": "^1.11.13",
    "html-to-text": "^9.0.5",
    "lodash": "^4.17.21",
    "mantine-datatable": "^8.3.13",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "15.2.6",
    "next-auth": "5.0.0-beta.25",
    "openai": "^6.1.0",
    "papaparse": "^5.5.3",
    "postmark": "^4.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-use": "^17.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@eslint/eslintrc": "^3.3.1",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@testcontainers/postgresql": "^11.12.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/d3": "^7.4.3",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.14.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "msw": "^2.10.5",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.15",
    "testcontainers": "^11.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  }
}
